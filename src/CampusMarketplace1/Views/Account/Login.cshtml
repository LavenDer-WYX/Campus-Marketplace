@{
  ViewData["Title"] = "Login";
}

@* 登录页面目前只构建表单位置 *@
<section class="small-page">
 <h1>Login</h1>

   <p>
     Login function will be added later.
   </p>

 <form>
   <div class="mb-3">
      <label for="email"
             class="form-label">
        University Email
      </label>

       <input id="email"
              type="email"
              class="form-control" />
   </div>

    <div class="mb-3">
       <label for="password"
              class="form-label">
         Password
       </label>

      <input id="password"
             type="password"
             class="form-control" />
    </div>

   <button type="button"
           class="btn btn-dark">
      Login
   </button>
 </form>
</section>
