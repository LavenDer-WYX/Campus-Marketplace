
@model IReadOnlyList<Report>
@{

    ViewData["Title"] = "Review reports";

    var currentStatus = ViewData["Status"] as string;
}

<h1>Review reports</h1>
<p>Showing: @currentStatus</p>

<div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-outline-secondary" asp-action="Reports" asp-route-status="Pending">Pending</a>
    <a class="btn btn-outline-secondary" asp-action="Reports" asp-route-status="Dismissed">Dismissed</a>
    <a class="btn btn-outline-secondary" asp-action="Reports" asp-route-status="ActionTaken">Action taken</a>
    <a class="btn btn-outline-secondary" asp-action="Reports" asp-route-status="All">All</a>
    <a class="btn btn-outline-secondary" asp-action="Index">Dashboard</a>
</div>


@if (Model.Count == 0)
{
    <p>No reports match this filter.</p>
}
else
{

    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead>
                <tr><th scope="col">Item</th><th scope="col">Status</th><th scope="col">Submitted (UTC)</th><th scope="col">Action</th></tr>
            </thead>
            <tbody>

                @foreach (var report in Model)
                {
                    <tr>
                        <td>@report.ListingTitle</td>
                        <td>@report.Status</td>
                        <td>@report.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td><a asp-action="Details" asp-route-id="@report.Id">Review</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
