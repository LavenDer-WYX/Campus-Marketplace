@model Listing
@{
    ViewData["Title"] = Model.Title;
}
<section>
    <div class="details-layout">
        <div class="details-image">
            @if (Model.Photos.Count > 0)
            {
                <img src="@Model.Photos.First().ImageUrl" alt="@Model.Title" class="listing-main-photo" />
            }
            else
            {
                <span>Item image</span>
            }
        </div>
        <div class="details-information">
            <span class="condition-badge condition-good">@Model.Condition</span>
            <h1>@Model.Title</h1>
            <p class="item-price">
                @(Model.ListingType == "Sale" && Model.Price.HasValue
                    ? Model.Price.Value.ToString("C", CultureInfo.GetCultureInfo("en-NZ"))
                    : Model.ListingType)
            </p>
            <p><strong>Category:</strong> @Model.Category?.Name</p>
            <p><strong>Type:</strong> @Model.ListingType</p>
            <p><strong>Location:</strong> @Model.PickupLocation</p>
            <p><strong>Status:</strong> @Model.Status</p>
            <h2>Description</h2>
            <p>@Model.Description</p>
            <p class="text-muted">Seller: @(Model.Seller?.Nickname ?? "Student seller")</p>
            @if (User.Identity?.IsAuthenticated == true && ViewBag.IsOwner == true)
            {
                <a class="btn btn-dark" asp-action="Edit" asp-route-id="@Model.Id">Edit this listing</a>
            }
            else if (User.Identity?.IsAuthenticated == true)
            {
                <div class="d-flex gap-2 mb-3">
                    <form asp-controller="Favourites" asp-action="Toggle" method="post">
                        <input type="hidden" name="listingId" value="@Model.Id" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                        <button class="btn btn-outline-dark" type="submit">
                            @(ViewBag.IsFavourite == true ? "Remove favourite" : "Add to favourites")
                        </button>
                    </form>
                    <form asp-controller="Messages" asp-action="Start" method="post">
                        <input type="hidden" name="listingId" value="@Model.Id" />
                        <button class="btn btn-dark" type="submit">Contact seller</button>
                    </form>
                </div>

                @if (ViewBag.HasPendingRequest == true)
                {
                    <p class="text-muted">You already have a pending request for this item.</p>
                }
                else if (Model.IsAvailable && Model.Status == "Available")
                {
                    <form asp-controller="TradeRequests" asp-action="Create" method="post">
                        <input type="hidden" name="listingId" value="@Model.Id" />
                        <label for="tradeNote" class="form-label">Message to seller (optional)</label>
                        <textarea id="tradeNote" name="note" class="form-control mb-2" maxlength="500"></textarea>
                        <button class="btn btn-success" type="submit">
                            @(Model.ListingType == "Sale" ? "Request to buy" : Model.ListingType == "Swap" ? "Request to swap" : "Request item")
                        </button>
                    </form>
                }
            }
            else
            {
                <a class="btn btn-dark" asp-controller="Account" asp-action="Login">Login to contact seller</a>
            }
        </div>
    </div>
</section>
