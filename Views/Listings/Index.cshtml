@model IReadOnlyList<Listing>
@{
    ViewData["Title"] = "Browse items";
    var favouriteIds = ViewBag.FavouriteIds as HashSet<int> ?? new HashSet<int>();
    string selectedCondition = ViewData["Condition"] as string ?? string.Empty;
    string selectedType = ViewData["ListingType"] as string ?? string.Empty;
    string selectedSort = ViewData["SortBy"] as string ?? "newest";
    int? selectedDays = ViewData["PostedWithinDays"] as int?;
    string smartQuery = ViewData["SmartQuery"] as string ?? string.Empty;
    string? smartMessage = ViewData["SmartSearchMessage"] as string;
    string? smartError = ViewData["SmartSearchError"] as string;
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Browse items</h1>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Create" class="btn btn-dark">Create listing</a>
    }
</div>

<section class="border rounded p-3 mb-4" aria-labelledby="smart-search-heading">
    <h2 id="smart-search-heading" class="h5">AI Smart Search</h2>
    <p class="small text-muted mb-2">
        Describe what you need in normal language. AI only converts your request into filters; all results come from this marketplace database.
    </p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <form asp-action="SmartSearch" method="post" class="d-flex gap-2">
            @Html.AntiForgeryToken()
            <input name="Query" value="@smartQuery" maxlength="300" required class="form-control"
                   aria-label="Natural language item search"
                   placeholder="For example: cheap desk under $50 near Albany" />
            <button type="submit" class="btn btn-dark text-nowrap">Smart search</button>
        </form>
    }
    else
    {
        <p class="mb-0"><a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Sign in</a> to use AI Smart Search.</p>
    }
    @if (!string.IsNullOrWhiteSpace(smartMessage))
    {
        <div class="alert alert-success mt-3 mb-0" role="status">@smartMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(smartError))
    {
        <div class="alert alert-warning mt-3 mb-0" role="alert">@smartError</div>
    }
</section>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-3"><input name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search title or description" aria-label="Keyword" /></div>
    <div class="col-md-2"><select name="categoryId" asp-items="ViewBag.Categories" class="form-select" aria-label="Category"><option value="">All categories</option></select></div>
    <div class="col-md-2">
        <select name="condition" class="form-select" aria-label="Condition">
            <option value="">Any condition</option>
            <option selected="@(selectedCondition == "Like new")">Like new</option>
            <option selected="@(selectedCondition == "Good")">Good</option>
            <option selected="@(selectedCondition == "Fair")">Fair</option>
            <option selected="@(selectedCondition == "Poor")">Poor</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="listingType" class="form-select" aria-label="Listing type">
            <option value="">Any type</option>
            <option selected="@(selectedType == "Sale")">Sale</option>
            <option selected="@(selectedType == "Swap")">Swap</option>
            <option selected="@(selectedType == "Giveaway")">Giveaway</option>
        </select>
    </div>
    <div class="col-md-1"><input name="minimumPrice" value="@ViewData["MinimumPrice"]" type="number" min="0" max="100000" step="0.01" class="form-control" placeholder="Min $" aria-label="Minimum price" /></div>
    <div class="col-md-1"><input name="maximumPrice" value="@ViewData["MaximumPrice"]" type="number" min="0" max="100000" step="0.01" class="form-control" placeholder="Max $" aria-label="Maximum price" /></div>
    <div class="col-md-1"><button class="btn btn-dark w-100" type="submit">Go</button></div>
    <div class="col-md-3"><input name="location" value="@ViewData["Location"]" maxlength="100" class="form-control" placeholder="Pickup location" aria-label="Pickup location" /></div>
    <div class="col-md-2">
        <select name="postedWithinDays" class="form-select" aria-label="Date posted">
            <option value="">Any date</option>
            <option value="1" selected="@(selectedDays == 1)">Last 24 hours</option>
            <option value="7" selected="@(selectedDays == 7)">Last 7 days</option>
            <option value="30" selected="@(selectedDays == 30)">Last 30 days</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="sortBy" class="form-select" aria-label="Sort order">
            <option value="newest" selected="@(selectedSort != "price_low_to_high")">Newest first</option>
            <option value="price_low_to_high" selected="@(selectedSort == "price_low_to_high")">Lowest price first</option>
        </select>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="empty-area">No listings match the selected filters.</div>
}
else
{
    <div class="item-grid">
        @foreach (var listing in Model)
        {
            var categoryClass = (listing.Category?.Name ?? "other").ToLowerInvariant();
            <article class="item-card">
                <div class="item-image image-@categoryClass">
                    @if (listing.Photos.Count > 0)
                    {
                        <img src="@listing.Photos.First().ImageUrl" alt="@listing.Title" />
                    }
                    else
                    {
                        <span>@(listing.Category?.Name ?? "Other")</span>
                    }
                </div>
                <div class="item-body">
                    <span class="condition-badge condition-good">@listing.Condition</span>
                    <h3>@listing.Title</h3>
                    <p class="item-price">
                        @(listing.ListingType == "Sale" && listing.Price.HasValue
                            ? listing.Price.Value.ToString("C", CultureInfo.GetCultureInfo("en-NZ"))
                            : listing.ListingType)
                    </p>
                    <p class="item-meta">@listing.PickupLocation · @listing.ListingType</p>
                    <div class="item-actions">
                        <a asp-action="Details" asp-route-id="@listing.Id">View item</a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-controller="Favourites" asp-action="Toggle" method="post">
                                <input type="hidden" name="listingId" value="@listing.Id" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <button type="submit" class="fav-btn @(favouriteIds.Contains(listing.Id) ? "fav-active" : "")" aria-label="Save to favourites">
                                    @(favouriteIds.Contains(listing.Id) ? "♥" : "♡")
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </article>
        }
    </div>
}
