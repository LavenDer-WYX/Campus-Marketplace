
@model IReadOnlyList<Report>
@{

    ViewData["Title"] = "My reports";
}

<h1>My reports</h1>
<p>Check the progress of reports you submitted.</p>


@if (Model.Count == 0)
{
    <p>You have not reported any items.</p>
}
else
{

    @foreach (var report in Model)
    {
        <article class="card mb-3">
            <div class="card-body">
                <h2 class="h5">@report.ListingTitle</h2>
                <p><strong>Status:</strong> @report.Status</p>
                <p><strong>Submitted (UTC):</strong> @report.CreatedAt.ToString("yyyy-MM-dd HH:mm")</p>

                <p style="white-space: pre-wrap; overflow-wrap: anywhere;">@report.Reason</p>

                @if (report.Status != "Pending")
                {
                    <p><strong>Reviewed (UTC):</strong> @report.ResolvedAt?.ToString("yyyy-MM-dd HH:mm")</p>
                    <p style="white-space: pre-wrap; overflow-wrap: anywhere;"><strong>Review note:</strong> @(report.AdminNote ?? "No additional note.")</p>
                }

                @if (report.ListingId == null)
                {
                    <p class="text-muted">The item has been deleted.</p>
                }
            </div>
        </article>
    }
}


<a asp-controller="Listings" asp-action="Index">Browse items</a>
