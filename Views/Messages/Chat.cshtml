@model MessagePageViewModel
@inject UserManager<AppUser> UserManager
@{
    ViewData["Title"] = "Chat";
    var currentUserId = UserManager.GetUserId(User);
    var otherPerson = Model.Conversation.BuyerId == currentUserId
        ? Model.Conversation.Seller?.Nickname
        : Model.Conversation.Buyer?.Nickname;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-1">@Model.Conversation.Listing?.Title</h1>
        <div class="text-muted">Chat with @otherPerson</div>
    </div>
    <a asp-action="Index">All messages</a>
</div>

<div class="message-box">
    @if (Model.Messages.Count == 0)
    {
        <p class="text-muted">No messages yet. Say hello.</p>
    }
    @foreach (var message in Model.Messages)
    {
        <div class="chat-message @(message.SenderId == currentUserId ? "my-message" : "other-message")">
            <strong>@message.Sender?.Nickname</strong>
            <div>@message.Content</div>
            <small>@message.SentAt.ToLocalTime().ToString("g")</small>
        </div>
    }
</div>

<form asp-action="Send" method="post" class="message-input">
    <input type="hidden" name="conversationId" value="@Model.Conversation.Id" />
    <input type="text" name="content" class="form-control" maxlength="1000" placeholder="Write a message" required />
    <button type="submit" class="btn btn-dark">Send</button>
</form>
