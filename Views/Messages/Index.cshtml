@model IReadOnlyList<Conversation>
@inject UserManager<AppUser> UserManager
@{
    ViewData["Title"] = "Messages";
    var currentUserId = UserManager.GetUserId(User);
}

<h1>Messages</h1>

@if (Model.Count == 0)
{
    <div class="empty-area">No conversations yet. Open an item and contact its seller.</div>
}
else
{
    <div class="list-group">
        @foreach (var conversation in Model)
        {
            var otherPerson = conversation.BuyerId == currentUserId
                ? conversation.Seller?.Nickname
                : conversation.Buyer?.Nickname;
            var lastMessage = conversation.Messages.OrderByDescending(x => x.SentAt).FirstOrDefault();
            <a asp-action="Chat" asp-route-id="@conversation.Id" class="list-group-item list-group-item-action">
                <strong>@conversation.Listing?.Title</strong> — @otherPerson
                <div class="text-muted">@(lastMessage?.Content ?? "No messages yet")</div>
            </a>
        }
    </div>
}
